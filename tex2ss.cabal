cabal-version:      3.0
name:               tex2ss
version:            0.1.0.0
synopsis:           A LaTeX-first static site generator based on Pandoc and Hakyll
description:
  tex2ss turns physical LaTeX bundles into a static HTML site and transactional
  PDF snapshots. Pandoc owns the document AST and HTML conversion pipeline;
  Hakyll owns dependency-aware site compilation, routing, and templates; a
  structured latexmk recipe owns PDF execution.
license:             GPL-2.0-or-later
license-file:        LICENSE
author:              tex2ss contributors
maintainer:          tex2ss contributors
category:            Web
build-type:          Simple
extra-doc-files:     README.md CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/ZEPHYR65537/tex2ss.git
  branch: main

common warnings
  default-language: GHC2021
  default-extensions: DerivingStrategies
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Tex2ss.Analysis
    Tex2ss.App
    Tex2ss.Build
    Tex2ss.Config
    Tex2ss.Diagnostics
    Tex2ss.Discovery
    Tex2ss.Generator
    Tex2ss.Include
    Tex2ss.Manifest
    Tex2ss.Pandoc
    Tex2ss.Paths
    Tex2ss.Pdf
    Tex2ss.Scaffold
    Tex2ss.Serve
    Tex2ss.SiteIndex
    Tex2ss.Types
  build-depends:
    aeson >=2.2 && <2.4,
    base >=4.20 && <4.21,
    bytestring >=0.12 && <0.13,
    containers >=0.6 && <0.8,
    crypton >=1.0 && <1.1,
    data-default >=0.8 && <0.9,
    directory >=1.3.8 && <1.4,
    filepath >=1.4.200 && <1.6,
    fsnotify >=0.4 && <0.5,
    hakyll ==4.17.1.0,
    http-types >=0.12 && <0.13,
    hslua >=2.5 && <2.6,
    mtl >=2.3 && <2.4,
    optparse-applicative >=0.18 && <0.20,
    pandoc ==3.11,
    pandoc-lua-engine ==0.5.4,
    pandoc-types >=1.23.1 && <1.24,
    process >=1.6 && <1.7,
    temporary >=1.3 && <1.4,
    text >=2.1 && <2.2,
    time >=1.12 && <1.15,
    transformers >=0.6 && <0.7,
    wai >=3.2 && <3.3,
    wai-app-static >=3.1 && <3.2,
    warp >=3.4 && <3.5

executable tex2ss
  import: warnings
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    base,
    tex2ss

test-suite tex2ss-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    BuildSpec
    ConfigSpec
    DiscoverySpec
    GeneratorSpec
    IncludeSpec
    PandocSpec
    PathsSpec
    PdfSpec
    PostAnalysisSpec
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    directory,
    filepath,
    pandoc-types,
    tasty >=1.5 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    temporary >=1.3 && <1.4,
    text,
    tex2ss
